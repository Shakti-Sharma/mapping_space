# Copy to server/.env and fill in. All values optional except for Google Drive.
PORT=4000

# Comma-separated paths that may NEVER be deleted (in addition to built-in guards)
PROTECTED_PATHS=

# Google Drive (phase 2). Create an OAuth "Desktop app" or "Web app" client at
# https://console.cloud.google.com/apis/credentials and enable the Google Drive API.
# Authorized redirect URI must be: http://localhost:4000/api/gdrive/callback
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
